{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "faheem557/db-lite-admin",
    "type": "library",
    "description": "A Laravel package providing a database admin UI with Blade views and navigation support.",
    "homepage": "https://github.com/Faheem557/db-lite-admin",
    "repository": "https://github.com/Faheem557/db-lite-admin",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/view": "^13.0",
        "illuminate/auth": "^13.0",
        "illuminate/http": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "DbLiteAdmin\\": "packages/db-lite-admin/src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DbLiteAdmin\\DbLiteAdminServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
